diff -uprN withoutPCIe-EP/meta-renesas/meta-rzt2h/recipes-kernel/linux/linux-renesas/0001-misc-pci_endpoint_test-update-RZ-T2H-in-pci_device_i.patch withPCIe-EP/meta-renesas/meta-rzt2h/recipes-kernel/linux/linux-renesas/0001-misc-pci_endpoint_test-update-RZ-T2H-in-pci_device_i.patch
--- withoutPCIe-EP/meta-renesas/meta-rzt2h/recipes-kernel/linux/linux-renesas/0001-misc-pci_endpoint_test-update-RZ-T2H-in-pci_device_i.patch	1970-01-01 09:00:00.000000000 +0900
+++ withPCIe-EP/meta-renesas/meta-rzt2h/recipes-kernel/linux/linux-renesas/0001-misc-pci_endpoint_test-update-RZ-T2H-in-pci_device_i.patch	2025-04-16 13:23:28.551416400 +0900
@@ -0,0 +1,43 @@
+From 03a942bbb821a839b4799ee80423e79d63eb7ac6 Mon Sep 17 00:00:00 2001
+From: Nhat Nguyen <nhat.nguyen.xb@renesas.com>
+Date: Mon, 24 Mar 2025 13:38:28 +0700
+Subject: [PATCH 1/4] misc: pci_endpoint_test: update RZ/T2H in pci_device_id
+ table
+
+Update RZ/T2H in pci_device_id table so that pci-epf-test can be used
+for testing PCIe EP in RZ/T2H and RZ/N2H.
+
+Signed-off-by: Nhat Nguyen <nhat.nguyen.xb@renesas.com>
+---
+ drivers/misc/pci_endpoint_test.c | 8 +++++++-
+ 1 file changed, 7 insertions(+), 1 deletion(-)
+
+diff --git a/drivers/misc/pci_endpoint_test.c b/drivers/misc/pci_endpoint_test.c
+index 8cf2d3fa9c20e..9857c18c966d6 100644
+--- a/drivers/misc/pci_endpoint_test.c
++++ b/drivers/misc/pci_endpoint_test.c
+@@ -947,6 +947,12 @@ static const struct pci_endpoint_test_data j721e_data = {
+ 	.irq_type = IRQ_TYPE_MSI,
+ };
+ 
++static const struct pci_endpoint_test_data rzt2h_data = {
++	.test_reg_bar = BAR_0,
++	.alignment = SZ_64K,
++	.irq_type = IRQ_TYPE_MSI,
++};
++
+ static const struct pci_device_id pci_endpoint_test_tbl[] = {
+ 	{ PCI_DEVICE(PCI_VENDOR_ID_TI, PCI_DEVICE_ID_TI_DRA74x),
+ 	  .driver_data = (kernel_ulong_t)&default_data,
+@@ -969,7 +975,7 @@ static const struct pci_device_id pci_endpoint_test_tbl[] = {
+ 	{ PCI_DEVICE(PCI_VENDOR_ID_RENESAS, PCI_DEVICE_ID_RENESAS_R8A774C0),},
+ 	{ PCI_DEVICE(PCI_VENDOR_ID_RENESAS, PCI_DEVICE_ID_RENESAS_R8A774E1),},
+ 	{ PCI_DEVICE(PCI_VENDOR_ID_RENESAS, PCI_DEVICE_ID_RENESAS_R9A09077),
+-	.driver_data = (kernel_ulong_t)&default_data,
++	.driver_data = (kernel_ulong_t)&rzt2h_data,
+ 	},
+ 	{ PCI_DEVICE(PCI_VENDOR_ID_TI, PCI_DEVICE_ID_TI_J721E),
+ 	  .driver_data = (kernel_ulong_t)&j721e_data,
+-- 
+2.25.1
+
diff -uprN withoutPCIe-EP/meta-renesas/meta-rzt2h/recipes-kernel/linux/linux-renesas/0002-pci-pcie-rzt2h-window-fix-outbound-setting-in-endpoi.patch withPCIe-EP/meta-renesas/meta-rzt2h/recipes-kernel/linux/linux-renesas/0002-pci-pcie-rzt2h-window-fix-outbound-setting-in-endpoi.patch
--- withoutPCIe-EP/meta-renesas/meta-rzt2h/recipes-kernel/linux/linux-renesas/0002-pci-pcie-rzt2h-window-fix-outbound-setting-in-endpoi.patch	1970-01-01 09:00:00.000000000 +0900
+++ withPCIe-EP/meta-renesas/meta-rzt2h/recipes-kernel/linux/linux-renesas/0002-pci-pcie-rzt2h-window-fix-outbound-setting-in-endpoi.patch	2025-04-16 13:23:28.586050600 +0900
@@ -0,0 +1,30 @@
+From 9369ebf4eac751f20bec1c2443c27cb8a58c3b17 Mon Sep 17 00:00:00 2001
+From: Nhat Nguyen <nhat.nguyen.xb@renesas.com>
+Date: Mon, 24 Mar 2025 14:00:55 +0700
+Subject: [PATCH 2/4] pci: pcie-rzt2h-window: fix outbound setting in endpoint
+ mode
+
+Fix outbound setting in endpoint mode. cpu_addr value should be
+gotten directly from devicetree.
+
+Signed-off-by: Nhat Nguyen <nhat.nguyen.xb@renesas.com>
+---
+ drivers/pci/controller/pcie-rzt2h-window.c | 2 --
+ 1 file changed, 2 deletions(-)
+
+diff --git a/drivers/pci/controller/pcie-rzt2h-window.c b/drivers/pci/controller/pcie-rzt2h-window.c
+index ff5bfb201b343..296d66b38397e 100644
+--- a/drivers/pci/controller/pcie-rzt2h-window.c
++++ b/drivers/pci/controller/pcie-rzt2h-window.c
+@@ -104,8 +104,6 @@ void rzt2h_pcie_ep_set_outbound(struct rzt2h_pcie *pcie, int win, struct resourc
+ 	else
+ 		mask = 0x0;
+ 
+-	cpu_addr = (cpu_addr - 0xA0000000) | 0x400000000UL;
+-
+ 	/* PW0 addr: PCIE_WINDOW_BASEU_REG: 0x1104   PCIE_WINDOW_BASEL_REG: 0x1100 */
+ 	rzt2h_pci_write_reg(pcie, (u32)(cpu_addr >> 32), PCIE_WINDOW_BASEU_REG(win));
+ 	rzt2h_rmw(pcie, PCIE_WINDOW_BASEL_REG(win), 0xFFFFF000, (u32)(cpu_addr & 0xFFFFF000));
+-- 
+2.25.1
+
diff -uprN withoutPCIe-EP/meta-renesas/meta-rzt2h/recipes-kernel/linux/linux-renesas/0003-arm64-dts-renesas-r9a09g077-Update-memory-region-def.patch withPCIe-EP/meta-renesas/meta-rzt2h/recipes-kernel/linux/linux-renesas/0003-arm64-dts-renesas-r9a09g077-Update-memory-region-def.patch
--- withoutPCIe-EP/meta-renesas/meta-rzt2h/recipes-kernel/linux/linux-renesas/0003-arm64-dts-renesas-r9a09g077-Update-memory-region-def.patch	1970-01-01 09:00:00.000000000 +0900
+++ withPCIe-EP/meta-renesas/meta-rzt2h/recipes-kernel/linux/linux-renesas/0003-arm64-dts-renesas-r9a09g077-Update-memory-region-def.patch	2025-04-16 13:23:28.626090200 +0900
@@ -0,0 +1,34 @@
+From 0f70b11ae2114183f3f5b0f5d8cf41e1f788c661 Mon Sep 17 00:00:00 2001
+From: Hoa Huynh <hoa.huynh.ud@renesas.com>
+Date: Tue, 15 Apr 2025 00:22:02 +0700
+Subject: [PATCH 3/4] arm64: dts: renesas: r9a09g077: Update memory region
+ definitions used for PCIe EP
+
+PCIe EP will use 64-bit memory areas for
+its settings, so this patch updates the memory
+region definitions from the 32-bit area to the
+64-bit area
+
+Signed-off-by: Hoa Huynh <hoa.huynh.ud@renesas.com>
+---
+ arch/arm64/boot/dts/renesas/r9a09g077.dtsi | 4 ++--
+ 1 file changed, 2 insertions(+), 2 deletions(-)
+
+diff --git a/arch/arm64/boot/dts/renesas/r9a09g077.dtsi b/arch/arm64/boot/dts/renesas/r9a09g077.dtsi
+index 81ce0648d0d8f..8be2b221471af 100644
+--- a/arch/arm64/boot/dts/renesas/r9a09g077.dtsi
++++ b/arch/arm64/boot/dts/renesas/r9a09g077.dtsi
+@@ -1457,8 +1457,8 @@ pcie0_ep: pcie-ep@92100000 {
+ 			compatible = "renesas,rzt2h-pcie-ep";
+ 			reg = <0x0 0x92100000 0x0 0x8000>,
+ 				<0x0 0x80292000 0x0 0x30>,
+-				<0x0 0xA0000000 0x0 0x08000000>,
+-				<0x0 0xA8000000 0x0 0x08000000>;
++				<0x4 0x00000000 0x0 0x10000000>,
++				<0x5 0x00000000 0x0 0x10000000>;
+ 			reg-names = "pcie-base", "supplemental", "memory0", "memory1";
+ 			interrupts = <GIC_SPI 797 IRQ_TYPE_LEVEL_HIGH>;
+ 			clocks = <&cpg CPG_MOD R9A09G077_PCIE_CLK>;
+-- 
+2.25.1
+
diff -uprN withoutPCIe-EP/meta-renesas/meta-rzt2h/recipes-kernel/linux/linux-renesas/0004-arm64-dts-renesas-r9a09g087-update-memory-map-for-PC.patch withPCIe-EP/meta-renesas/meta-rzt2h/recipes-kernel/linux/linux-renesas/0004-arm64-dts-renesas-r9a09g087-update-memory-map-for-PC.patch
--- withoutPCIe-EP/meta-renesas/meta-rzt2h/recipes-kernel/linux/linux-renesas/0004-arm64-dts-renesas-r9a09g087-update-memory-map-for-PC.patch	1970-01-01 09:00:00.000000000 +0900
+++ withPCIe-EP/meta-renesas/meta-rzt2h/recipes-kernel/linux/linux-renesas/0004-arm64-dts-renesas-r9a09g087-update-memory-map-for-PC.patch	2025-04-16 13:23:28.646444000 +0900
@@ -0,0 +1,41 @@
+From eeed483c79a816228668bcd8b12a01547046fcf8 Mon Sep 17 00:00:00 2001
+From: Nhat Nguyen <nhat.nguyen.xb@renesas.com>
+Date: Mon, 24 Mar 2025 14:07:15 +0700
+Subject: [PATCH 4/4] arm64: dts: renesas: r9a09g087: update memory map for
+ PCIe EP mode on RZ/N2H
+
+Update memory map for PCIe EP mode from 256-MB PCIE0 mirror area to
+8-GB PCIE0 area on RZ/N2H SoC.
+
+Signed-off-by: Nhat Nguyen <nhat.nguyen.xb@renesas.com>
+---
+ arch/arm64/boot/dts/renesas/r9a09g087.dtsi | 6 ++++--
+ 1 file changed, 4 insertions(+), 2 deletions(-)
+
+diff --git a/arch/arm64/boot/dts/renesas/r9a09g087.dtsi b/arch/arm64/boot/dts/renesas/r9a09g087.dtsi
+index 23af8a8b1d6e7..142d4c16f2d9a 100644
+--- a/arch/arm64/boot/dts/renesas/r9a09g087.dtsi
++++ b/arch/arm64/boot/dts/renesas/r9a09g087.dtsi
+@@ -1459,6 +1459,8 @@ pcie0: pcie@92100000 {
+ 			power-domains = <&cpg>;
+ 			resets = <&cpg R9A09G077_PCIE_RST>;
+ 			ranges = <0x02000000 0x0 0xA0000000 0x4 0x00000000 0x0 0x10000000>;
++			/* Un-comment in case need to test PCIE1 mirror (0xB000_0000) area */
++			//ranges = <0x02000000 0x0 0xB0000000 0x4 0x00000000 0x0 0x10000000>;
+ 			dma-ranges = <0x02000000 0x0 0xC4000000 0x0 0xC4000000 0x0 0x3C000000>,
+ 				     <0x42000000 0x2 0x40000000 0x2 0x40000000 0x1 0xC0000000>;
+ 			interrupts = <GIC_SPI 790 IRQ_TYPE_LEVEL_HIGH>;
+@@ -1477,8 +1479,8 @@ pcie0_ep: pcie-ep@92100000 {
+ 			compatible = "renesas,rzn2h-pcie-ep";
+ 			reg = <0x0 0x92100000 0x0 0x10000>,
+ 			      <0x0 0x80292000 0x0 0x30>,
+-			      <0x0 0xA0000000 0x0 0x08000000>,
+-			      <0x0 0xA8000000 0x0 0x08000000>;
++			      <0x4 0x00000000 0x1 0x00000000>,
++			      <0x5 0x00000000 0x1 0x00000000>;
+ 			reg-names = "apb-base0", "apb-base1", "memory0", "memory1";
+ 			interrupts = <GIC_SPI 797 IRQ_TYPE_LEVEL_HIGH>;
+ 			clocks = <&cpg CPG_MOD R9A09G077_PCIE_CLK>;
+-- 
+2.25.1
+
